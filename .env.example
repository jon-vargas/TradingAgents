# ============================================================
# TradingAgents — Environment Variables
# Copy to .env and fill in your keys
# ============================================================

# OpenAI API Key (Required — powers all LLM analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Finnhub API Key (Required — default vendor for news data)
# Get free key from: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage API Key (Required for fundamental and technical data)
# Get free key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Perplexity API Key (Optional — enables "deep" analysis mode + catalyst pipeline,
# management quality, and revenue concentration research queries)
# PERPLEXITY_API_KEY=your_perplexity_api_key_here
# PERPLEXITY_API_MODE=agent
# Legacy Sonar Chat Completions (PERPLEXITY_API_MODE=sonar) only through 2026-09-27.

# Optional: For using Anthropic models instead of OpenAI
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: For using Google models instead of OpenAI
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: Custom results directory (default: ./research_output)
# TRADINGAGENTS_RESULTS_DIR=./results

# Optional: TradingView chart layout ID for ticker deep links.
# If set, expanded-row "TradingView Layout" opens:
#   https://www.tradingview.com/chart/<ID>/?symbol=EXCHANGE%3ATICKER
# Example:
# TRADINGVIEW_CHART_ID=TxiihJ7N
